{
  "title": "Inference & Watchlist Activity",
  "uid": "sentinelgrid-inference-watchlist",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Processed FPS per camera",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sentinelgrid_frames_processed_total[1m])) by (camera_id)",
          "legendFormat": "{{camera_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inference latency (p50/p95) seconds",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(sentinelgrid_inference_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sentinelgrid_inference_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Plate reads per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(sentinelgrid_plates_read_total[1m])) * 60",
          "legendFormat": "plates/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Watchlist match rate (alerts over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(sentinelgrid_watchlist_matches_total[5m]) * 60",
          "legendFormat": "matches/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Watchlist matches (last 24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "increase(sentinelgrid_watchlist_matches_total[24h])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Scene discontinuities (last 24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(sentinelgrid_scene_discontinuities_total[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "API request rate by status code",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(sentinelgrid_api_requests_total[5m])) by (status_code)",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ]
    }
  ]
}
