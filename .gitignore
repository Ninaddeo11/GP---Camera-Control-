# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
apps/web/.next/
apps/web/out/

# Env
.env
.env.local

# go2rtc.yaml in services/ingestion-config/generated/ is intentionally
# tracked, not ignored: it's the placeholder checked in so go2rtc has a
# valid config on the very first `docker compose up`, before
# stream_manager.py overwrites it from the live catalogue (see that
# file's own header comment). It will show as locally modified after the
# stack has run once — that's expected, not a mistake.

# TLS certs generated by infra/nginx/generate-self-signed-cert.sh
infra/nginx/certs/*.pem

# Local AI-tooling config, not project source
.claude/

# Model weights
services/inference/models/*.pt
services/inference/models/*.onnx
services/inference/models/*.engine
!services/inference/models/.gitkeep

# Data
data/
snapshots/
*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
*.pid
