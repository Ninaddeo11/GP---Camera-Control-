{# Auto-generated by stream_manager.py — do not edit by hand.
   Regenerated on every catalogue reconciliation cycle so go2rtc can recover
   the full stream list on a cold restart even if the live API push is lost.

   go2rtc is the ONLY re-streaming layer in Sentinel Grid: it republishes
   every ingested camera as RTSP, WHEP, and HLS from this single instance
   (see README.md "go2rtc output endpoints"), so there is no separate HLS
   relay to configure here. #}
api:
  listen: ":1984"
  origin: "*"

rtsp:
  listen: ":8554"

webrtc:
  listen: ":8555"
  candidates:
    # A direct host candidate, not just the STUN-derived one — this stack
    # runs behind Docker Desktop's NAT/port-mapping layer even for "local"
    # access, and relying on STUN alone left the browser with no candidate
    # it could actually reach: WHEP signaling succeeded (201 Created) but
    # the ICE/media connection then silently stalled and every tile
    # eventually flipped to "error". 127.0.0.1:8555 matches the port this
    # compose file actually publishes go2rtc's WebRTC listener on, so the
    # browser (which always reaches this stack via localhost) has a
    # candidate that resolves to a real, reachable socket.
    - "127.0.0.1:8555"
    - stun:stun.l.google.com:19302

log:
  level: {{ log_level | default("info") }}
  format: text

streams:
{% for cam in cameras %}
  {{ cam.camera_id }}: "{{ cam.source_url }}"
{% else %}
  {}
{% endfor %}
