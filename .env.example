# ============================================================================
# Sentinel Grid — environment configuration
# Copy to .env and fill in real values before running docker compose.
# ============================================================================

# --- Postgres / PostGIS -----------------------------------------------------
POSTGRES_DB=sentinelgrid
POSTGRES_USER=sentinelgrid
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinelgrid:change-me-in-production@postgres:5432/sentinelgrid

# --- Redis (also the Phase 4+ event bus via Redis Streams) -------------------
# The audit log has no Redis stream of its own — services/audit_service.py
# writes straight to Postgres, since its hash chain needs a single
# consistent order of appends (see that module's docstring), which a
# stream with multiple consumer groups doesn't guarantee.
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_DETECTIONS=detections
REDIS_STREAM_PLATE_EVENTS=plate_events
REDIS_STREAM_VEHICLE_EVENTS=vehicle_events
REDIS_STREAM_WATCHLIST_MATCHES=watchlist_matches
REDIS_STREAM_CAMERA_HEALTH=camera_health

# --- Camera gateway catalogue -------------------------------------------
# Default source is gateway-adapter (services/gateway-adapter), which
# bridges to the real camera gateway — see REAL_GATEWAY_* below. It
# re-exposes the same /api/ingest contract shape the bundled `catalogue`
# mock service does, so nothing downstream needed to change; point
# INGEST_API_URL back at http://catalogue:9000/api/ingest to use the mock
# instead (e.g. offline dev, or the real gateway's credentials expiring).
INGEST_API_URL=http://gateway-adapter:9100/api/ingest
INGEST_API_AUTH_HEADER=
INGEST_API_AUTH_TOKEN=
INGEST_POLL_INTERVAL_SECONDS=60

# --- gateway-adapter (services/gateway-adapter) -------------------------
# Real credentials — never commit real values here; this file only ships
# placeholders. The real gateway is a cookie-authenticated dashboard (not
# the bare /api/ingest the contract in docs/gateway-contract.md
# describes), so this adapter logs in once, keeps the session, and
# proxies the HLS playlist/segments/key through itself — see
# services/gateway-adapter/app.py's docstring for why.
REAL_GATEWAY_BASE_URL=https://cctv.corp8.cloud
REAL_GATEWAY_EMAIL=
REAL_GATEWAY_PASSWORD=
ADAPTER_BASE_URL=http://gateway-adapter:9100

# --- go2rtc (the platform's only ingestion/re-streaming layer) ---------------
GO2RTC_API_URL=http://go2rtc:1984
GO2RTC_RTSP_PORT=8554
GO2RTC_CONFIG_PATH=/config/go2rtc.yaml

# --- stream_manager (services/ingestion-config) ------------------------------
STREAM_MANAGER_METRICS_PORT=9092
RECONNECT_BACKOFF_INITIAL_SECONDS=2
RECONNECT_BACKOFF_MAX_SECONDS=30

# --- Inference service (services/inference) ----------------------------------
# GPU confirmed available for this deployment — CUDA is the default device.
SENTINELGRID_DEVICE=cuda:0
GO2RTC_RTSP_HOST=go2rtc
YOLO_MODEL_PATH=models/yolo11s.pt
BYTETRACK_CONFIG=bytetrack.yaml
YOLO_VEHICLE_CONF_THRESHOLD=0.45
YOLO_PERSON_CONF_THRESHOLD=0.50
TARGET_FPS_PER_CAMERA=5
MIN_FPS_PER_CAMERA=2
MAX_CONSECUTIVE_READ_FAILURES=15
DISCONTINUITY_GAP_MS=4000
REDIS_STREAM_MAXLEN=500000
INFERENCE_METRICS_PORT=9090

# --- ANPR (Phase 5) -----------------------------------------------------------
# No fine-tuned Indian-plate model ships in this repo — PLATE_MODEL_PATH
# points at a file that doesn't exist yet by default, which is expected:
# ANPR disables itself cleanly until one is provided. See README.md
# "ANPR model gap".
PLATE_MODEL_PATH=models/yolo11n-plate.pt
YOLO_PLATE_CONF_THRESHOLD=0.50
ANPR_OCR_MIN_CONFIDENCE=0.65
ANPR_MIN_CROP_WIDTH=80
ANPR_MIN_CROP_HEIGHT=30
ANPR_SKIP_RERUN_ABOVE_CONFIDENCE=0.90
ANPR_REPUBLISH_MARGIN=0.05
SNAPSHOT_DIR=/data/snapshots

# --- Multi-vehicle ANPR upgrade (plate quality / secondary OCR / temporal fusion) ---
# See docs/anpr-pipeline.md for what each stage does. Defaults reproduce
# the pre-upgrade behavior as closely as possible where a knob controls
# something genuinely new (e.g. TEMPORAL_FUSION_MIN_OBSERVATIONS_FOR_PUBLISH=1
# keeps "publish as soon as one good read exists").
PLATE_QUALITY_MIN_SHARPNESS=0.08
PLATE_QUALITY_SHARPNESS_CEILING=400.0
PLATE_QUALITY_SIZE_CEILING_MULTIPLIER=3.0
PLATE_QUALITY_CONTRAST_CEILING=60.0
PLATE_QUALITY_ENABLE_CLAHE=true
PLATE_QUALITY_ENABLE_SHARPEN=true
PLATE_QUALITY_ENABLE_DENOISE=false
PLATE_QUALITY_UPSCALE_MAX_FACTOR=2.0
OCR_SECONDARY_ENABLED=true
OCR_SECONDARY_TRIGGER_BELOW_CONFIDENCE=0.75
TEMPORAL_FUSION_MAX_OBSERVATIONS=20
TEMPORAL_FUSION_MIN_OBSERVATIONS_FOR_PUBLISH=1
TRACK_LOST_GRACE_FRAMES=10
# No fine-tuned manufacturer/model classifier ships in this repo — these
# paths point at files that don't exist yet by default, which is expected:
# classification enrichment disables itself cleanly (reports "Unknown")
# until models are provided. See vehicle_classifier.py.
ENABLE_VEHICLE_CLASSIFICATION=true
MANUFACTURER_MODEL_PATH=models/manufacturer-classifier.pt
VEHICLE_MODEL_CLASSIFIER_PATH=models/vehicle-model-classifier.pt
MAKEMODEL_VLM_PATH=models/makemodel-vlm-450m
CLASSIFIER_HIGH_CONFIDENCE_THRESHOLD=0.85
CLASSIFIER_PROBABLE_CONFIDENCE_THRESHOLD=0.60
CLASSIFICATION_MIN_FRAMES_BEFORE_ATTEMPT=3
EVIDENCE_SAVE_BEST_VEHICLE_FRAME=true
EVIDENCE_SAVE_BEST_PLATE_CROP=true
# Enforced by services/api/scripts/cleanup_expired_evidence.py (run via
# cron), not automatically — see that script's docstring.
EVIDENCE_RETENTION_DAYS=30

# --- API service (services/api) -----------------------------------------------
# /metrics is served on this same service's port 8000 — no separate
# metrics port (see config.py).
# "development" (default) or "production" — gates whether
# scripts/seed_users.py will run and whether POST /auth/forgot-password
# echoes the reset token in its response (see both files' docstrings).
ENVIRONMENT=development
JWT_SECRET_KEY=change-me-super-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Both origins the browser might actually use: through nginx's TLS (the
# documented path) and directly against the web container (convenient for
# debugging, since docker-compose also publishes 3000:3000).
CORS_ORIGINS=https://localhost,http://localhost:3000

# --- Web app (apps/web, Next.js) ----------------------------------------------
# NEXT_PUBLIC_* values are baked into the client bundle at `docker compose
# build` time (see apps/web/Dockerfile) — changing these needs a rebuild,
# not just a restart. NEXT_PUBLIC_API_BASE_URL and
# NEXT_PUBLIC_GO2RTC_WHEP_BASE_URL are the only two read by app code
# (lib/api-client.ts, lib/use-whep.ts). NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS
# controls the login page's "demo accounts" hint block (app/login/page.tsx)
# — leave unset/false on any real deployment; only meant for local/
# evaluation use so a tester doesn't need credentials handed to them
# separately.
NEXT_PUBLIC_API_BASE_URL=https://localhost/api
NEXT_PUBLIC_GO2RTC_WHEP_BASE_URL=https://localhost/go2rtc
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
# "whep" (default) uses WebRTC for low-latency playback — needs a network
# that can carry its UDP media plane (true for the local docker-compose
# stack). "hls" falls back to plain-HTTPS segment playback (lib/use-hls.ts)
# for deployments that can't, like Render (HTTPS-only ingress, no UDP).
NEXT_PUBLIC_VIDEO_PROTOCOL=whep

# --- Grafana (Phase 10) -------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
